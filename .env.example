# TickIT Backend Configuration
# Copy this file to .env and fill in actual values (never commit .env with secrets)

# ===== Database Configuration =====
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tickit
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# ===== Spring Boot Configuration =====
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true
SPRING_APPLICATION_NAME=tickit-backend

# ===== Security / JWT Configuration =====
TICKIT_SECURITY_JWT_SECRET=your-very-long-secret-key-minimum-32-characters-for-hs512-algorithm
TICKIT_SECURITY_JWT_EXPIRATION_MS=86400000

# ===== Cryptography Configuration =====
# RSA 2048 key pair for audit trail signing (PEM format)
# Generate with: openssl genrsa -out private_key.pem 2048 && openssl rsa -in private_key.pem -pubout -out public_key.pem
CRYPTO_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n[your-private-key-base64-encoded]\n-----END RSA PRIVATE KEY-----
CRYPTO_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n[your-public-key-base64-encoded]\n-----END PUBLIC KEY-----

# ===== Automation / SLA Schedules (Cron Format) =====
TICKIT_AUTOMATION_OVERDUE_CASES_SCHEDULE=0 0 * * * *
TICKIT_AUTOMATION_RESOLUTION_SLA_SCHEDULE=0 */6 * * * *
TICKIT_AUTOMATION_RESPONSE_SLA_SCHEDULE=0 */3 * * * *

# ===== Server Configuration =====
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/

# ===== File Storage Configuration =====
TICKIT_STORAGE_UPLOAD_DIR=./uploads
TICKIT_STORAGE_MAX_FILE_SIZE=10485760

# ===== Logging =====
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_SOFRECOM_TICKIT=DEBUG

# ===== RAG / AI Configuration (Optional) =====
# FastAPI RAG service endpoint (if deployed)
# RAG_SERVICE_URL=http://localhost:8001
# RAG_RETRIEVE_ENDPOINT=/retrieve
